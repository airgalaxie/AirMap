{
  "rules": [
    {
      "match": {"special_type": "chest"},
      "layer": "chest",
      "texture_directory": "entity/chest/"
    },
    {
      "match": {"special_type": "shulker_box"},
      "layer": "shulker_box",
      "texture_directory": "entity/shulker/"
    },
    {
      "match": {"special_type": "copper_golem_statue"},
      "layer": {
        "property": "special.pose",
        "cases": {
          "standing": "copper_golem_statue_standing",
          "sitting": "copper_golem_statue_sitting",
          "running": "copper_golem_statue_running",
          "star": "copper_golem_statue_star"
        },
        "fallback": "copper_golem_statue_standing"
      }
    },
    {
      "match": {"model_prefix": "minecraft:block/bell_"},
      "layer": {"model_basename": true}
    }
  ]
}
